exports[`CityLandingPage without content > renders the pre-content-module markup 1`] = `"<div class="min-h-screen"><header class="mx-auto flex max-w-2xl items-center justify-between px-6 pt-6"><a class="flex items-center gap-2 font-semibold text-stone-900 dark:text-stone-100" href="/"><svg viewBox="0 0 24 24" class="h-6 w-6 text-bark-700 dark:text-stone-400" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l4 3.33V5.5h2.5v3.92L21 11.5"></path><path d="M5 10.5V20h14v-9.5"></path><g class="text-sprout-600 dark:text-sprout-300"><path d="M12 18.7C12.3 16.6 11.4 15 11.9 12.9 12.1 12 12.4 11.4 12.6 10.9" stroke="currentColor" stroke-width="1.05"></path><path d="M11.75 15.30C11.88 13.99 9.92 13.07 8.63 13.50C8.90 14.83 10.68 16.07 11.75 15.30z" fill="currentColor" stroke="none"></path><path d="M12.00 14.00C13.19 14.90 15.32 13.53 15.71 12.03C14.24 11.51 11.92 12.51 12.00 14.00z" fill="currentColor" stroke="none"></path><path d="M12.35 11.70C13.33 11.76 13.98 10.27 13.62 9.32C12.63 9.55 11.75 10.92 12.35 11.70z" fill="currentColor" stroke="none"></path><path d="M12.20 12.00C12.48 11.29 11.56 10.52 10.79 10.59C10.72 11.36 11.49 12.28 12.20 12.00z" fill="currentColor" stroke="none"></path></g></svg> OakTend</a><a class="rounded-lg border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 hover:border-bark-500 hover:text-bark-700 dark:border-white/10 dark:text-stone-300 dark:hover:text-stone-300" href="/homeowner-signup">Get started free</a></header><main class="mx-auto max-w-2xl px-6 pb-16 pt-10"><nav aria-label="Breadcrumb" class="mb-6 text-sm text-stone-500 dark:text-stone-400"><a class="hover:text-bark-700 hover:underline dark:hover:text-stone-300" href="/">OakTend</a><span aria-hidden="true"> / </span><a class="hover:text-bark-700 hover:underline dark:hover:text-stone-300" href="/oc">Orange County</a><span aria-hidden="true"> / </span><span aria-current="page" class="text-stone-700 dark:text-stone-300">Fountain Valley</span></nav><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"OakTend","item":"http://localhost:3000/"},{"@type":"ListItem","position":2,"name":"Orange County","item":"http://localhost:3000/oc"},{"@type":"ListItem","position":3,"name":"Fountain Valley","item":"http://localhost:3000/fountain-valley"}]}</script><div class="text-center"><h1 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl dark:text-stone-100">Home maintenance and local pros in Fountain Valley</h1><p class="mx-auto mt-4 max-w-xl text-stone-600 dark:text-stone-300">Fountain Valley is mostly single-family tract homes built in the 1960s and 1970s, so a lot of the housing stock is now 50-plus years old, with original plumbing runs and systems well into or past their expected lifespan.</p><p class="mx-auto mt-3 max-w-xl text-sm text-stone-500 dark:text-stone-400">OakTend serves all of Orange County, California, not just Fountain Valley.</p><a class="btn-primary mt-6 px-6 py-3 text-base shadow-md" href="/homeowner-signup">Get started free</a></div><section class="mt-14"><h2 class="text-center text-xl font-semibold text-stone-900 dark:text-stone-100">What OakTend does</h2><div class="mt-6 grid gap-4 sm:grid-cols-2"><div class="card"><div class="icon-chip" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list h-5 w-5" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="M12 11h4"></path><path d="M12 16h4"></path><path d="M8 11h.01"></path><path d="M8 16h.01"></path></svg></div><h3 class="mt-3 font-semibold text-stone-900 dark:text-stone-100">A maintenance plan built around your home</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">OakTend turns your home's age, systems, and history into a plan of what to check and when, not a generic checklist.</p></div><div class="card"><div class="icon-chip" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square h-5 w-5" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path></svg></div><h3 class="mt-3 font-semibold text-stone-900 dark:text-stone-100">Ask OakTend anything about your house</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">Get answers about your systems, their ages, and what's likely to need attention next, any time.</p></div><div class="card"><div class="icon-chip" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wrench h-5 w-5" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"></path></svg></div><h3 class="mt-3 font-semibold text-stone-900 dark:text-stone-100">Local pros, no bidding war</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">When a pro lists a California license, we check it against the state's public CSLB database and show the result. Every pro who applies shows up in one place, so you compare and choose instead of sorting through a pile of quotes.</p></div><div class="card"><div class="icon-chip" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gift h-5 w-5" aria-hidden="true"><path d="M12 7v14"></path><path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"></path><rect x="3" y="7" width="18" height="4" rx="1"></rect></svg></div><h3 class="mt-3 font-semibold text-stone-900 dark:text-stone-100">Free to start</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">Free during our preview, no card needed.</p></div></div></section><section class="mt-14"><h2 class="text-center text-xl font-semibold text-stone-900 dark:text-stone-100">Guides for Fountain Valley homeowners</h2><ul class="mt-6 space-y-3"><li><a class="card block transition hover:border-bark-500 hover:shadow-md" href="/guides/slab-leak-signs"><h3 class="font-semibold text-stone-900 dark:text-stone-100">Slab leak signs</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">How to spot one early in an older slab-foundation home.</p></a></li><li><a class="card block transition hover:border-bark-500 hover:shadow-md" href="/guides/socal-home-maintenance-calendar"><h3 class="font-semibold text-stone-900 dark:text-stone-100">SoCal home maintenance calendar</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">A month-by-month calendar built for the coastal SoCal climate.</p></a></li><li><a class="card block transition hover:border-bark-500 hover:shadow-md" href="/guides/water-heater-replacement-cost"><h3 class="font-semibold text-stone-900 dark:text-stone-100">Water heater replacement cost</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">Typical price range and when a repair is the smarter call.</p></a></li><li><a class="card block transition hover:border-bark-500 hover:shadow-md" href="/guides/hvac-replacement-cost"><h3 class="font-semibold text-stone-900 dark:text-stone-100">HVAC replacement cost</h3><p class="mt-1 text-sm text-stone-600 dark:text-stone-300">Typical price range and central AC vs. heat pump.</p></a></li></ul></section><section class="mt-12 rounded-2xl border border-bark-100 bg-bark-50 p-6 text-center shadow-sm dark:border-bark-700 dark:bg-bark-700/20"><h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">Get the answer for YOUR home</h2><p class="mx-auto mt-2 max-w-md text-sm text-stone-600 dark:text-stone-300">The numbers above are general ranges. OakTend uses the age, size, and systems you enter for your home to give you a planning range of your own, free.</p><a class="btn-primary mt-5 px-6 py-2.5" href="/homeowner-signup">Get started free</a></section></main><footer class="mx-auto max-w-2xl border-t border-stone-200 px-6 py-6 text-center dark:border-white/10"><p class="inline-flex w-full items-center justify-center gap-1.5 text-xs text-stone-500 dark:text-stone-400"><svg viewBox="0 0 24 24" class="h-4 w-4 text-bark-700 dark:text-stone-400" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l4 3.33V5.5h2.5v3.92L21 11.5"></path><path d="M5 10.5V20h14v-9.5"></path><g class="text-sprout-600 dark:text-sprout-300"><path d="M12 18.7C12.3 16.6 11.4 15 11.9 12.9 12.1 12 12.4 11.4 12.6 10.9" stroke="currentColor" stroke-width="1.05"></path><path d="M11.75 15.30C11.88 13.99 9.92 13.07 8.63 13.50C8.90 14.83 10.68 16.07 11.75 15.30z" fill="currentColor" stroke="none"></path><path d="M12.00 14.00C13.19 14.90 15.32 13.53 15.71 12.03C14.24 11.51 11.92 12.51 12.00 14.00z" fill="currentColor" stroke="none"></path><path d="M12.35 11.70C13.33 11.76 13.98 10.27 13.62 9.32C12.63 9.55 11.75 10.92 12.35 11.70z" fill="currentColor" stroke="none"></path><path d="M12.20 12.00C12.48 11.29 11.56 10.52 10.79 10.59C10.72 11.36 11.49 12.28 12.20 12.00z" fill="currentColor" stroke="none"></path></g></svg> OakTend · Your home looked after</p><p class="mt-2 text-xs"><a class="text-stone-500 hover:text-bark-700 hover:underline dark:text-stone-400 dark:hover:text-stone-300" href="/guides">All guides</a></p></footer></div>"`;

exports[`CityLandingPage without content > renders the same template with homeowner preview mode on 1`] = `"<div class="min-h-screen"><header class="mx-auto flex max-w-2xl items-center justify-between px-6 pt-6"><a class="flex items-center gap-2 font-semibold text-stone-900 dark:text-stone-100" href="/"><svg viewBox="0 0 24 24" class="h-6 w-6 text-bark-700 dark:text-stone-400" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l4 3.33V5.5h2.5v3.92L21 11.5"></path><path d="M5 10.5V20h14v-9.5"></path><g class="text-sprout-600 dark:text-sprout-300"><path d="M12 18.7C12.3 16.6 11.4 15 11.9 12.9 12.1 12 12.4 11.4 12.6 10.9" stroke="currentColor" stroke-width="1.05"></path><path d="M11.75 15.30C11.88 13.99 9.92 13.07 8.63 13.50C8.90 14.83 10.68 16.07 11.75 15.30z" fill="currentColor" stroke="none"></path><path d="M12.00 14.00C13.19 14.90 15.32 13.53 15.71 12.03C14.24 11.51 11.92 12.51 12.00 14.00z" fill="currentColor" stroke="none"></path><path d="M12.35 11.70C13.33 11.76 13.98 10.27 13.62 9.32C12.63 9.55 11.75 10.92 12.35 11.70z" fill="currentColor" stroke="none"></path><path d="M12.20 12.00C12.48 11.29 11.56 10.52 10.79 10.59C10.72 11.36 11.49 12.28 12.20 12.00z" fill="currentColor" stroke="none"></path></g></svg> OakTend</a><a class="rounded-lg border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 hover:border-bark-500 hover:text-bark-700 dark:border-white/10 dark:text-stone-300 dark:hover:text-stone-300" href="/homeowner-signup">Get started free</a></header><main class="mx-auto max-w-2xl px-6 pb-16 pt-10"><nav aria-label="Breadcrumb" class="mb-6 text-sm text-stone-500 dark:text-stone-400"><a class="hover:text-bark-700 hover:underline dark:hover:text-stone-300" href="/">OakTend</a><span aria-hidden="true"> / </span><a class="hover:text-bark-700 hover:underline dark:hover:text-stone-300" href="/oc">Orange County</a><span aria-hidden="true"> / </span><span aria-curre